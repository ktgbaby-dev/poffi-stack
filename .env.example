# Poffi Stack ordering platform: environment variables.
# Copy to .env.local for local development (never commit it). In production, set these in
# Vercel → Project → Settings → Environment Variables (mark secrets as "Sensitive").

# ---- Required ----------------------------------------------------------------------------
# Postgres connection string. On Vercel use the POOLED Neon URL (host contains "-pooler").
# Local development can use PGlite instead:  DATABASE_URL=pglite:./.data/dev
DATABASE_URL=

# Public address of the site, no trailing slash. Used in Paystack callback URLs and email links.
SITE_URL=https://example.com

# Long random strings (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
CRON_SECRET=

# One-time code that lets the first owner create their dashboard login at /admin.
# Remove it from Vercel after the owner login exists.
ADMIN_SETUP_TOKEN=

# ---- Paystack ----------------------------------------------------------------------------
# Secret key from Paystack → Settings → API Keys & Webhooks. Start with sk_test_...
PAYSTACK_SECRET_KEY=
# Webhook signing secret (whsec_...) from Paystack → Developers → API configuration.
# During a rotation you can list two, comma-separated.
PAYSTACK_WEBHOOK_SECRET=
# Live keys (sk_live_...) are refused until this is "true". Only set it after the go-live checks.
PAYSTACK_ALLOW_LIVE=false

# ---- Email (Resend) ---------------------------------------------------------------------------
RESEND_API_KEY=
# Sender, from a domain verified in Resend, e.g.  Poffi Stack <orders@yourdomain.com>
EMAIL_FROM=
# Optional: where customer replies go (defaults to the contact email in Settings).
EMAIL_REPLY_TO=
# Optional fallback for owner alerts if no notification email is set in the dashboard.
OWNER_NOTIFICATION_EMAIL=
# resend-scheduled (default, works on Vercel Hobby) or cron (needs the cron to run every few minutes).
REMINDER_DELIVERY=resend-scheduled

# ---- Optional -------------------------------------------------------------------------------
# Max Postgres connections per function instance (default 3).
DB_POOL_MAX=3
