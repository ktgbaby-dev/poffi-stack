{
  "name": "poffi-stack-ordering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Poffi Stack online ordering and management platform (customer site, Paystack checkout, owner dashboard, email automation). Built by Kal's Digital.",
  "engines": { "node": ">=20" },
  "scripts": {
